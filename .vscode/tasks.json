{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start qemu",
            "type": "shell",
            "command": "make qemu-gdb",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^\\*\\*\\* Now run 'gdb' in another window\\.$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\*\\*\\* Now run 'gdb' in another window\\.$",
                    "endsPattern": ".*"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}